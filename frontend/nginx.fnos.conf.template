server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Large receiving lists should not require multi-megabyte public transfers.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/json application/javascript text/css image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 64m;
    location = /api { return 308 /api/; }
    location ^~ /api/ {
        # Resolve again after a backend container is replaced during an update.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $rma_backend backend:8088;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$rma_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${RMA_PUBLIC_SCHEME};
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_read_timeout 120s;
        proxy_redirect off;
    }

    location = /files { return 403; }
    location ^~ /files/ { return 403; }
    location ~ /\. { deny all; }
    location = /index.html {
        expires -1;
    }
    location / { try_files $uri $uri/ /index.html; }
}
