FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV REACT_APP_API_URL=/api GENERATE_SOURCEMAP=false
RUN npm run build

FROM nginx:stable-alpine
COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.fnos.conf.template /etc/nginx/templates/default.conf.template
# NAS archive extraction can leave copied public assets readable only by root.
# Nginx workers need read access to files and traversal access to directories.
RUN find /usr/share/nginx/html -type d -exec chmod 755 {} + \
    && find /usr/share/nginx/html -type f -exec chmod 644 {} + \
    && chmod 644 /etc/nginx/templates/default.conf.template
EXPOSE 80
