# Copy this file to .env beside compose.fnos.yaml on the NAS.
# Replace these two numbers with `id -u` and `id -g` for the NAS user
# who owns the data and logs folders.
RMA_UID=1000
RMA_GID=1000

# Relative paths are relative to compose.fnos.yaml. Both folders must exist.
RMA_DATA_DIR=./data
RMA_LOG_DIR=./logs

RMA_PORT=3000
RMA_BIND_ADDRESS=0.0.0.0

# Use http for initial LAN access. Use https only after configuring an
# HTTPS reverse proxy with the original Host header, as described in the guide.
RMA_PUBLIC_SCHEME=http
